  "overview": {
    "durationMs": 81389.0717,
    "chapters": [
      {
        "start": 274.8363999999999,
        "text": "A signed fictional refund event enters a durable PostgreSQL inbox. Acceptance is separate from successful processing."
      },
      {
        "start": 12786.7164,
        "text": "Three identical redeliveries return the original receipt. The event still has one processing attempt and one local completion."
      },
      {
        "start": 25721.6544,
        "text": "Version 2 was applied before version 1 arrived. The older snapshot is recorded as stale; the completed projection stays at version 2."
      },
      {
        "start": 39823.1759,
        "text": "This fictional handler keeps failing. Automatic retries have a bounded budget and preserve every attempt."
      },
      {
        "start": 55404.799699999996,
        "text": "The operator repairs the demo cause, then requests replay with a reason. Repair alone does not rewrite or restart the accepted event."
      },
      {
        "start": 62975.2869,
        "text": "Replay succeeded in a new processing cycle. The original receipt and bytes are unchanged, all three failures remain, and exactly one local completion exists."
      }
    ]
  },
